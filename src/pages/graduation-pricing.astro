---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCards from '../components/PackageCards.astro';
import GoodToKnow from '../components/GoodToKnow.astro';
import CtaBand from '../components/CtaBand.astro';
import PricingFaq from '../components/PricingFaq.astro';
import { graduationFaq } from '../data/faq';
import { graduation } from '../data/pricing';
---

<BaseLayout
  title="Graduation Photo Pricing | New Haven CT | Elm City Photography"
  description="Graduation portrait pricing from Elm City Photography in New Haven, CT. Sessions from $175, add another graduate for $125. Travel anywhere in Connecticut included."
>
  <section class="px-5 pt-20 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <h1 class="sr-only">Graduation sessions</h1>
      <PackageCards packages={graduation} />
      <div class="mx-auto mt-12 flex max-w-3xl flex-col gap-2 rounded-3xl bg-mint px-8 py-5 text-forest sm:flex-row sm:items-center sm:justify-between sm:rounded-full">
        <p><strong>Celebrating together?</strong> Add another graduate to The Portrait or The Celebration.</p>
        <p class="shrink-0 font-bold">+$125 each</p>
      </div>
    </div>
  </section>

  <GoodToKnow />

  <PricingFaq items={graduationFaq} />

  <CtaBand title="Book your grad session." secondary={{ href: '/graduations/', label: 'See the portfolio' }} />
</BaseLayout>
