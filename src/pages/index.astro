---
import { Image, getImage } from 'astro:assets';
import { withBase } from '../lib/paths';
import { getGalleryImages } from '../lib/galleries';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutPhoto from '../assets/about-photo.jpg';
import heroLeft from '../assets/galleries/engagements-2026/0011.jpg';
import heroRight from '../assets/galleries/engagements-2026/0016.jpg';

const heroLeftImg = await getImage({ src: heroLeft, width: 1400, format: 'webp', quality: 82 });
const heroRightImg = await getImage({ src: heroRight, width: 1400, format: 'webp', quality: 82 });

// Display order for the homepage column.
const order = ['0005.jpg', '0006.jpg', '0007.jpg', '0008.jpg', '0009.jpg', '0002.jpg', '0003.jpg', '0004.jpg'];
const all = getGalleryImages('home-engagements');
const photos = order.map((f) => all.find((i) => i.filename === f)).filter((i) => !!i);

---

<BaseLayout
  title="Elm City Photography | Cinematic Wedding Photographer | New Haven CT"
  description="Cinematic, documentary-style wedding and engagement photography based in New Haven, CT. Honest moments, true-to-life color, and photos that still feel like you in twenty years."
  heroPreload={heroLeftImg.src}
>
  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <section class="bg-forest px-3 pb-3 pt-6 md:px-10 md:pb-10 md:pt-8">
    <p class="eyebrow mb-3 text-center text-gold md:mb-4"><span class="block sm:inline">Cinematic, documentary </span><span class="block sm:inline">weddings and engagements</span><span class="hidden sm:inline"> · </span><span class="block sm:inline">New Haven, CT</span></p>
    <h1 id="hero-type" aria-label="your story, in cinematic light" class="mx-auto max-w-6xl px-2 text-center text-[clamp(2.5rem,6vw,5.25rem)] leading-[1.04] text-cream">
      <span aria-hidden="true" data-type>your story, </span><span aria-hidden="true" data-type class="whitespace-nowrap text-gold">in cinematic light</span>
    </h1>
    <div class="mx-auto mt-8 grid max-w-[min(1440px,calc(120vh+0.75rem))] grid-cols-2 gap-2 md:mt-12 md:gap-3">
      <img src={heroLeftImg.src} alt="A couple sharing a kiss at golden hour" class="aspect-[2/3] w-full rounded-2xl object-cover md:aspect-[4/5] object-[50%_35%] md:rounded-3xl" fetchpriority="high" />
      <img src={heroRightImg.src} alt="A couple embracing between tall stone columns" class="aspect-[2/3] w-full rounded-2xl object-cover md:aspect-[4/5] object-[68%_78%] md:rounded-3xl" loading="eager" />
    </div>
  </section>

  <!-- ── HELLO ────────────────────────────────────────────────────── -->
  <section class="hello px-5 py-20 md:px-10 lg:px-[clamp(48px,5vw,128px)] lg:py-[clamp(96px,8vw,168px)]">
    <div class="hello-grid mx-auto max-w-[1640px]">
      <div class="hello-head">
        <p class="eyebrow hello-kicker text-gold-deep">Hi friends!</p>
        <h2 class="hello-title mt-4 text-forest">We're the two people behind the camera at Elm City Photography.</h2>
      </div>

      <div class="hello-photo">
        <div class="bg-white p-3 shadow-[0_1px_2px_rgba(29,42,32,0.14),0_22px_44px_-20px_rgba(29,42,32,0.4)] lg:p-[clamp(14px,1.3vw,24px)]">
          <Image
            src={aboutPhoto}
            alt="The two Elm City photographers sitting at the foot of a red lighthouse by the river"
            widths={[480, 720, 960, 1400]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            class="block aspect-[2/3] h-auto w-full object-cover"
          />
        </div>
      </div>

      <div class="hello-points">
        <p>If you feel awkward in photos, you're in good company, because we'll never ask you to stand still and smile. We'd much rather you wander around and laugh at each other's bad jokes while we tag along.</p>
        <p class="hello-line"><span class="draw-line">We're there to document, not to direct.</span></p>
        <p>Our favorite frames are the messy in-between ones, like hair blown sideways or a look you didn't know you gave, shot wide with plenty of sky so they feel like a movie.</p>
      </div>
    </div>
  </section>

  <!-- ── ENGAGEMENT PHOTOS ────────────────────────────────────────── -->
  <section class="bg-forest px-4 py-12 md:px-10 md:py-20">
    <ul class="mx-auto flex max-w-5xl flex-col items-center gap-12 md:gap-20">
      {photos.map((img) => (
        <li class="photo-reveal flex w-full justify-center">
          <div class="bg-[#fbfaf6] p-3 shadow-xl md:p-6">
            <Image
              src={img.image}
              alt={img.alt}
              widths={[640, 960, 1400, 2000]}
              sizes="(min-width: 1104px) 1024px, 100vw"
              class="block h-auto max-h-[calc(92vh-3rem)] w-auto max-w-full"
              loading="lazy"
            />
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 text-center md:mt-20">
      <a href={withBase('/contact/')} class="btn-pill btn-gold md:!px-16 md:!py-5">Book your session</a>
    </div>
  </section>
</BaseLayout>

<script>
  function armUnderlines() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const lines = document.querySelectorAll<HTMLElement>('.draw-line');
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('drawn');
        io.unobserve(e.target);
      }),
      { rootMargin: '0px 0px -15% 0px', threshold: 1 },
    );
    lines.forEach((el) => { el.setAttribute('data-armed', ''); io.observe(el); });
  }
  document.addEventListener('astro:page-load', armUnderlines);
</script>

<style>
  /* Hi friends: stacked on mobile (headline, photo, paragraph); editorial split on desktop. */
  .hello-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-areas: 'head' 'photo' 'points';
  }
  .hello-head { grid-area: head; }
  .hello-photo { grid-area: photo; max-width: 30rem; width: 100%; justify-self: center; }
  .hello-title {
    font-size: clamp(2.2rem, 7vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hello-points {
    grid-area: points;
    margin: 0;
    max-width: 38em;
    border-top: 2px solid var(--color-ink);
    padding-top: 1.1rem;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--color-forest-2);
  }
  .hello-points p { margin: 0; }
  .hello-points p + p { margin-top: 1em; }
  .hello-line { color: var(--color-ink); }
  /* Underline draws left to right once the line scrolls into view. Without JS it is simply shown. */
  .draw-line {
    background: linear-gradient(var(--color-gold-deep), var(--color-gold-deep)) no-repeat left bottom / 100% 2px;
    padding-bottom: 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .draw-line[data-armed] { background-size: 0% 2px; transition: background-size 1.2s cubic-bezier(0.65, 0, 0.35, 1) 0.6s; }
  .draw-line[data-armed].drawn { background-size: 100% 2px; }

  @media (min-width: 1024px) {
    .hello-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: '. photo' 'head photo' 'points photo' '. photo';
      column-gap: clamp(56px, 6.5vw, 128px);
      row-gap: 0;
    }
    .hello-photo { max-width: none; align-self: center; }
    .hello-title { font-size: clamp(46px, 4.3vw, 76px); }
    .hello-kicker { font-size: clamp(14px, 1.05vw, 18px); letter-spacing: 0.22em; }
    .hello-points { margin-top: clamp(36px, 3.5vw, 64px); padding-top: clamp(18px, 1.5vw, 28px); font-size: clamp(20px, 1.5vw, 26px); }
  }
</style>

<style is:global>
  #hero-type .ch { visibility: hidden; }
  #hero-type .ch.on { visibility: visible; }
  /* Zero-width box so the caret never changes line widths; the bar is drawn by ::after. */
  #hero-type .caret {
    display: inline-block;
    position: relative;
    width: 0;
    height: 0.9em;
    vertical-align: -0.08em;
    animation: caret-blink 1s steps(1) infinite;
  }
  #hero-type .caret::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0.04em;
    width: 0.06em;
    background: var(--color-gold);
  }
  @keyframes caret-blink { 50% { opacity: 0; } }
</style>

<script>
  function typeHero() {
    const h1 = document.getElementById('hero-type');
    if (!h1 || h1.dataset.typed) return;
    h1.dataset.typed = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Wrap every character so the full line keeps its final layout while hidden (no reflow while typing).
    const chars: HTMLSpanElement[] = [];
    h1.querySelectorAll<HTMLElement>('[data-type]').forEach((part) => {
      const text = part.textContent ?? '';
      part.textContent = '';
      for (const c of text) {
        const span = document.createElement('span');
        span.className = 'ch';
        span.textContent = c;
        part.appendChild(span);
        chars.push(span);
      }
    });

    const caret = document.createElement('span');
    caret.className = 'caret';
    chars[0]?.before(caret);

    let i = 0;
    const step = () => {
      if (i >= chars.length) return;
      const c = chars[i++];
      c.classList.add('on');
      // Park the caret before a space, never after it. After the space that ends line one
      // ("your story, "), the caret would stop that space from collapsing at the line end, so the
      // centered line grows by a space and jumps sideways when the caret moves to line two.
      if (c.textContent === ' ') c.before(caret);
      else c.after(caret);
      const pause = c.textContent === ',' ? 380 : c.textContent === ' ' ? 90 : 55 + Math.random() * 45;
      setTimeout(step, pause);
    };
    setTimeout(step, 450);
  }

  typeHero();
  document.addEventListener('astro:page-load', typeHero);
</script>
