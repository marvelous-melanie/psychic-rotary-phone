---
import { Image, getImage } from 'astro:assets';
import { withBase } from '../lib/paths';
import { getGalleryImages } from '../lib/galleries';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutPhoto from '../assets/about-photo.jpg';
import heroLeft from '../assets/galleries/engagements-2026/0011.jpg';
import heroRight from '../assets/galleries/engagements-2026/0016.jpg';

const heroLeftImg = await getImage({ src: heroLeft, width: 1400, format: 'webp', quality: 82 });
const heroRightImg = await getImage({ src: heroRight, width: 1400, format: 'webp', quality: 82 });

const eng = getGalleryImages('engagements-2026');
const grad = getGalleryImages('graduations-2026');
const pick = (list: typeof eng, names: string[]) => names.map((n) => list.find((i) => i.filename === n)).filter((i) => !!i);
const portfolio = [
  ...pick(eng, ['0001.jpg']),
  ...pick(grad, ['0003.jpg']),
  ...pick(eng, ['0008.jpg']),
  ...pick(grad, ['0011.jpg']),
  ...pick(eng, ['0015.jpg']),
  ...pick(grad, ['0001.jpg']),
  ...pick(eng, ['0006.jpg']),
  ...pick(grad, ['0014.jpg']),
  ...pick(eng, ['0010.jpg']),
  ...pick(grad, ['0017.jpg']),
];

const bigLinks = [
  { href: '/about/', label: 'Get to know us' },
  { href: '/engagement-pricing/', label: 'Sessions & pricing' },
  { href: '/engagements/', label: 'See the portfolio' },
  { href: '/contact/', label: 'Book your session' },
];

---

<BaseLayout
  title="Elm City Photography | Engagement & Graduation Photographer, New Haven CT"
  description="Engagement, proposal, and graduation photography rooted in New Haven, CT. True-to-life color, honest moments, and photos that still look like you in twenty years."
  heroPreload={heroLeftImg.src}
>
  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <section class="bg-forest px-3 pb-3 pt-6 md:px-10 md:pb-10 md:pt-8">
    <h1 id="hero-type" aria-label="your story, in true color" class="mx-auto max-w-6xl px-2 text-center text-[clamp(2.5rem,6vw,5.25rem)] leading-[1.04] text-cream">
      <span aria-hidden="true" data-type>your story, </span><span aria-hidden="true" data-type class="whitespace-nowrap text-gold">in true color</span>
    </h1>
    <div class="mx-auto mt-8 grid max-w-[min(1440px,calc(120vh+0.75rem))] grid-cols-2 gap-2 md:mt-12 md:gap-3">
      <img src={heroLeftImg.src} alt="A couple sharing a kiss at golden hour" class="aspect-[2/3] w-full rounded-2xl object-cover md:aspect-[4/5] object-[50%_35%] md:rounded-3xl" fetchpriority="high" />
      <img src={heroRightImg.src} alt="A couple embracing between tall stone columns" class="aspect-[2/3] w-full rounded-2xl object-cover md:aspect-[4/5] object-[68%_78%] md:rounded-3xl" loading="eager" />
    </div>
  </section>

  <!-- ── HELLO ────────────────────────────────────────────────────── -->
  <section class="relative px-5 pb-24 pt-20 md:px-10 md:pt-28">
    <div class="mx-auto max-w-6xl">
      <h2 class="mx-auto max-w-3xl text-center text-[clamp(2.2rem,4.6vw,3.75rem)] leading-[1.05] text-forest">
        Hi friends! We're the two people behind Elm City Photography.
      </h2>

      <div class="relative mt-16 grid items-start gap-10 md:grid-cols-[1fr_1.05fr_1fr] md:gap-12">
        <div class="space-y-5 text-[1.05rem] leading-relaxed text-ink/85 md:pt-10">
          <p><strong class="text-forest">We're a small New Haven photography team</strong> who started Elm City Photography because the moments that matter deserve to be documented accurately in images.</p>
          <p><strong class="text-forest">Not stiffly posed or over-editorialized.</strong> Just real: the way your day actually looked, felt, and sounded while you were in the middle of it.</p>
        </div>

        <div class="relative mt-6 md:mt-0">
          <div class="overflow-hidden rounded-2xl">
            <Image src={aboutPhoto} alt="The two Elm City photographers sitting at the foot of a red lighthouse by the river" width={900} height={1350} class="aspect-[2/3] h-full w-full object-cover" />
          </div>
        </div>

        <div class="relative space-y-5 text-[1.05rem] leading-relaxed text-ink/85 md:pt-10">
          <p><strong class="text-forest">Our editing is built around honest, timeless color.</strong> Skin tones that look like your skin. Greens that look like the park you were standing in.</p>
          <p><strong class="text-forest">No trendy presets, no awkward posing.</strong> Just photos that won't feel dated when you pull them out in twenty years.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── BIG LINKS ─────────────────────────────────────── -->
  <section class="relative bg-forest px-5 py-20 md:py-28">
    <ul class="relative mx-auto max-w-3xl space-y-5 md:space-y-7">
      {bigLinks.map((link) => (
        <li>
          <a
            href={withBase(link.href)}
            class="group flex items-center justify-between rounded-full bg-cream px-7 py-3 text-forest shadow-lg transition hover:bg-gold md:px-12 md:py-4"
          >
            <span class="font-display text-2xl md:text-[2.6rem] md:leading-tight">{link.label.split(' & ').map((part, j) => (<>{j > 0 && <> <span class="amp">&amp;</span> </>}{part}</>))}</span>
            <span class="text-2xl transition-transform group-hover:translate-x-1 md:text-3xl" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── PORTFOLIO ────────────────────────────────────────────────── -->
  <section class="px-3 pb-20 pt-20 md:px-10">
    <div class="mx-auto max-w-[1440px]">
      <div class="flex items-center justify-center">
        <a href={withBase('/engagements/')} class="group text-center">
          <h2 class="text-[clamp(2.4rem,5vw,4rem)] text-forest">
            Our Portfolio <span class="inline-block transition-transform group-hover:translate-x-2" aria-hidden="true">→</span>
          </h2>
        </a>
      </div>
      <div class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-5 md:gap-5">
        {portfolio.map((img, i) => (
          <a
            href={withBase(i % 2 === 0 ? '/engagements/' : '/graduations/')}
            class="group block overflow-hidden rounded-xl"
          >
            <Image
              src={img.image}
              alt={img.alt || (i % 2 === 0 ? 'Engagement session' : 'Graduation session')}
              width={600}
              height={600}
              class="aspect-square h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────── -->
  <section class="px-5 pb-24 md:px-10">
    <div class="text-center">
      <a href={withBase('/contact/')} class="btn-pill btn-dark md:!px-16 md:!py-5">Get in touch to save your date</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  #hero-type .ch { visibility: hidden; }
  #hero-type .ch.on { visibility: visible; }
  #hero-type .caret {
    display: inline-block;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.04em;
    margin-right: -0.1em;
    vertical-align: -0.08em;
    background: var(--color-gold);
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink { 50% { opacity: 0; } }
</style>

<script>
  function typeHero() {
    const h1 = document.getElementById('hero-type');
    if (!h1 || h1.dataset.typed) return;
    h1.dataset.typed = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Wrap every character so the full line keeps its final layout while hidden (no reflow while typing).
    const chars: HTMLSpanElement[] = [];
    h1.querySelectorAll<HTMLElement>('[data-type]').forEach((part) => {
      const text = part.textContent ?? '';
      part.textContent = '';
      for (const c of text) {
        const span = document.createElement('span');
        span.className = 'ch';
        span.textContent = c;
        part.appendChild(span);
        chars.push(span);
      }
    });

    const caret = document.createElement('span');
    caret.className = 'caret';
    chars[0]?.before(caret);

    let i = 0;
    const step = () => {
      if (i >= chars.length) return;
      const c = chars[i++];
      c.classList.add('on');
      c.after(caret);
      const pause = c.textContent === ',' ? 380 : c.textContent === ' ' ? 90 : 55 + Math.random() * 45;
      setTimeout(step, pause);
    };
    setTimeout(step, 450);
  }

  typeHero();
  document.addEventListener('astro:page-load', typeHero);
</script>
