---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LightboxGallery from '../components/LightboxGallery.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { getGalleryImages } from '../lib/galleries';

const galleries = await getCollection('galleries');
const gallery = galleries
  .filter((g) => g.data.type === 'graduation')
  .sort((a, b) => a.data.order - b.data.order)[0];

const images = gallery ? getGalleryImages(gallery.id) : [];

// Curated rows: each row shares one height. New photos not listed here are appended at the end.
const rows = [
  ['0017.jpg', '0002.jpg', '0015.jpg'],
  ['0007.jpg', '0011.jpg', '0013.jpg'],
  ['0001.jpg', '0010.jpg', '0006.jpg'],
  ['0008.jpg', '0003.jpg', '0016.jpg'],
  ['0014.jpg', '0018.jpg', '0005.jpg'],
  ['0004.jpg', '0012.jpg', '0009.jpg'],
];
---

<BaseLayout
  title="Graduation Portrait Photographer New Haven CT | Elm City Photography"
  description="Graduation portrait photography in New Haven, CT. Milestone portraits that feel like you, on one of the best days of your life. Sessions from $175."
>
  <PageHero
    eyebrow="Portfolio"
    title="Graduations"
  />

  <div class="pt-14">
    <LightboxGallery images={images} rows={rows} galleryId={gallery?.id ?? 'graduations'} />
  </div>

  <CtaBand
    title="Book your grad session."
    body="Sessions start at $175, and friends can join for $125 each. We'll get back to you within 48 hours."
    secondary={{ href: '/graduation-pricing/', label: 'See pricing' }}
  />
</BaseLayout>
