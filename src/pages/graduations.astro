---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LightboxGallery from '../components/LightboxGallery.astro';
import { getGalleryImages } from '../lib/galleries';
import { withBase } from '../lib/paths';

const galleries = await getCollection('galleries');
const gallery = galleries
  .filter((g) => g.data.type === 'graduation')
  .sort((a, b) => a.data.order - b.data.order)[0];

const images = gallery ? getGalleryImages(gallery.id) : [];
---

<BaseLayout
  title="Graduation Portrait Photographer New Haven CT | Elm City Photography"
  description="Graduation portrait photography in New Haven, CT. Milestone portraits that feel like you, on one of the best days of your life. Sessions from $175."
>

  <div class="bg-green-deep px-6 py-12 text-center">
    <p class="text-xs uppercase tracking-[0.38em] text-green-light/70">Portfolio</p>
    <h1 class="mt-4 font-serif text-5xl italic text-cream md:text-6xl">Graduations</h1>
    <p class="mx-auto mt-5 max-w-sm text-sm leading-7 text-green-light/70">
      You worked for this. Let's make sure you have the photos to prove it. Portraits that feel
      like you, on one of the best days of your life.
    </p>
  </div>

  <div class="bg-cream pt-12">
    <LightboxGallery images={images} galleryId={gallery?.id ?? 'graduations'} />
  </div>

  <section class="bg-cream px-6 py-24 text-center">
    <p class="text-xs uppercase tracking-[0.35em] text-muted">Work together</p>
    <h2 class="mt-4 font-serif text-4xl italic text-ink md:text-5xl">Ready to book?</h2>
    <p class="mx-auto mt-5 max-w-sm text-base leading-7 text-muted">
      Sessions start at $175. See the packages, or tell us about your plans and we'll get back to you within 48 hours.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-6 sm:flex-row">
      <a
        href={withBase('/contact/')}
        class="inline-block bg-green-deep px-10 py-3.5 text-xs uppercase tracking-[0.28em] text-cream transition-colors hover:bg-green-mid"
      >
        Book with Us
      </a>
      <a
        href={withBase('/graduation-pricing/')}
        class="inline-block border-b border-ink/30 pb-px text-xs uppercase tracking-[0.28em] text-ink transition-colors hover:border-ink"
      >
        See Pricing →
      </a>
    </div>
  </section>

</BaseLayout>
