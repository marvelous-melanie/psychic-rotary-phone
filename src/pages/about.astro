---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import aboutPhoto from '../assets/about-photo.jpg';
---

<BaseLayout
  title="About | Photographers in New Haven CT | Elm City Photography"
  description="Meet Elm City Photography, a small cinematic, documentary-style wedding photography studio based in New Haven, CT, serving Connecticut, New England, and beyond."
>
  <section class="bg-forest px-5 pb-16 pt-12 text-cream md:px-10 md:pb-24 md:pt-16">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <p class="eyebrow !text-base text-gold md:!text-lg">About us</p>
        <h1 class="mt-5 text-[clamp(2.6rem,5.6vw,4.75rem)] leading-[1.02]"><span class="block">hi, we're</span><span class="block">elm city</span><span class="block">photography.</span></h1>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-cream/80">
          Two storytellers based in New Haven, Connecticut. We photograph weddings and engagements the way they actually happen, and frame them like scenes from a movie.
        </p>
      </div>
      <div class="relative">
        <Image
          src={aboutPhoto}
          alt="The two Elm City photographers sitting at the foot of a red lighthouse by the river"
          widths={[640, 960, 1400]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-[2/3] w-full rounded-[2rem] object-cover"
          loading="eager"
        />
      </div>
    </div>
  </section>


  <section class="px-5 pt-20 md:px-10 md:pt-28">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1fr_1.4fr] md:gap-20">
      <div>
        <h2 class="text-[clamp(2.2rem,4.5vw,3.4rem)] leading-none text-forest">Why we started.</h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/85">
        <p>
          We started Elm City Photography because so many wedding photos look the same: the same poses, the same presets, the same shot list.
          We wanted to make photos that feel like the day itself, the nerves, the laughter, and the quiet moments nobody planned.
        </p>
        <p>
          So we work like documentary photographers. We watch, we wait, and we stay out of the way while your day unfolds.
          Then we frame it the way a filmmaker would, with careful light and composition, so the real moments look as big as they felt.
        </p>
      </div>
    </div>
  </section>

  <section class="px-5 pt-20 md:px-10 md:pt-24">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-3 md:gap-0">
      <div class="leading-relaxed text-ink/85 md:pr-10">
        <p class="font-display text-2xl text-forest">Documentary first.</p>
        <p class="mt-3">We don't direct your day. We follow it, catching the glances, the laughs, and the moments in between.</p>
      </div>
      <div class="border-gold leading-relaxed text-ink/85 md:border-l-2 md:px-10">
        <p class="font-display text-2xl text-forest">Cinematic by eye.</p>
        <p class="mt-3">Golden light, wide frames, close details. Every photo is composed like a still from a movie.</p>
      </div>
      <div class="border-gold leading-relaxed text-ink/85 md:border-l-2 md:pl-10">
        <p class="font-display text-2xl text-forest">Honest color.</p>
        <p class="mt-3">Skin that looks like skin and evenings that glow the way they really did. No trendy presets that will date your photos.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Let's tell your story." secondary={{ href: '/wedding-pricing/', label: 'See pricing' }} />
</BaseLayout>
