---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import aboutPhoto from '../assets/about-photo.jpg';
---

<BaseLayout
  title="About | Photographers in New Haven CT | Elm City Photography"
  description="Meet Elm City Photography, a small engagement and graduation photography studio based in New Haven, CT, serving Connecticut, New England, and beyond."
>
  <section class="bg-forest px-5 pb-16 pt-12 text-cream md:px-10 md:pb-24 md:pt-16">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <p class="eyebrow !text-base text-gold md:!text-lg">About us</p>
        <h1 class="mt-5 text-[clamp(2.6rem,5.6vw,4.75rem)] leading-[1.02]"><span class="block">hi, we're</span><span class="block">elm city</span><span class="block">photography.</span></h1>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-cream/80">
          A small studio based in New Haven, Connecticut. We photograph honestly and edit to match: colors that look like life, not like a filter.
        </p>
      </div>
      <div class="relative">
        <Image
          src={aboutPhoto}
          alt="The two Elm City photographers sitting at the foot of a red lighthouse by the river"
          widths={[640, 960, 1400]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-[2/3] w-full rounded-[2rem] object-cover"
          loading="eager"
        />
      </div>
    </div>
  </section>


  <section class="px-5 pt-20 md:px-10 md:pt-28">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1fr_1.4fr] md:gap-20">
      <div>
        <h2 class="text-[clamp(2.2rem,4.5vw,3.4rem)] leading-none text-forest">Why we started.</h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/85">
        <p>
          We started Elm City Photography because we believe the moments that matter most deserve to be preserved accurately.
          Not stiffly posed or over-editorialized. Just real, the way the day actually looked, felt, and sounded when you were in the middle of it.
        </p>
        <p>
          Our editing approach is built around accurate, timeless color. We don't chase trends. Skin tones that look like your skin.
          Greens that look like the park you were standing in. Images that won't feel dated when you pull them out in twenty years.
        </p>
      </div>
    </div>
  </section>

  <section class="px-5 pt-20 md:px-10 md:pt-24">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-3 md:gap-0">
      <div class="leading-relaxed text-ink/85 md:pr-10">
        <p class="font-display text-2xl text-forest">Available light.</p>
        <p class="mt-3">We work mostly with natural light and plan sessions around the golden hour, when everything looks its best.</p>
      </div>
      <div class="border-gold leading-relaxed text-ink/85 md:border-l-2 md:px-10">
        <p class="font-display text-2xl text-forest">Places with character.</p>
        <p class="mt-3">Coastlines, city parks, old architecture, golden fields. We know every corner of New Haven and the Connecticut landscape around it.</p>
      </div>
      <div class="border-gold leading-relaxed text-ink/85 md:border-l-2 md:pl-10">
        <p class="font-display text-2xl text-forest">Exactly like you.</p>
        <p class="mt-3">If you want photos that feel timeless but still look like you, with true colors and honest moments, we're probably the right fit.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Let's make something honest." secondary={{ href: '/engagement-pricing/', label: 'See pricing' }} />
</BaseLayout>
