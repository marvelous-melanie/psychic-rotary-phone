---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { getGalleryImages } from '../lib/galleries';

// One matted photo per row, like the homepage column: puffin first, then the other birds, foxes last.
const photos = getGalleryImages('wildlife');
---

<BaseLayout
  title="Wildlife & Bird Photography | Elm City Photography"
  description="Puffins, plovers, woodpeckers, foxes and more: wildlife and bird photography by Elm City Photography."
>
  <PageHero eyebrow="Portfolio" title="If you are a bird, we will take your picture for free!" />

  <section class="bg-forest px-4 pb-12 md:px-10 md:pb-20">
    <ul class="mx-auto flex max-w-5xl flex-col items-center gap-12 md:gap-20">
      {photos.map((img, i) => (
        <li class="photo-reveal flex w-full justify-center">
          <div class="bg-[#fbfaf6] p-3 shadow-xl md:p-6">
            <Image
              src={img.image}
              alt={img.alt}
              widths={[640, 960, 1400, 2000]}
              sizes="(min-width: 1104px) 1024px, 100vw"
              class="block h-auto max-h-[calc(92vh-3rem)] w-auto max-w-full"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand
    class="!mt-0 border-t border-cream/10"
    title="Not a bird?"
    body="We also photograph weddings and engagements. Tell us about your plans and we'll get back to you within 48 hours."
    secondary={{ href: '/', label: 'See our work' }}
  />
</BaseLayout>
