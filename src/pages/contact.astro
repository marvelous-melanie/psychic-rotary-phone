---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Instagram, Mail } from 'lucide-astro';

const field =
  'w-full rounded-2xl border-2 border-transparent bg-paper px-5 py-3.5 text-ink placeholder-ink/40 outline-none transition-colors focus:border-moss';
const label = 'mb-2 block text-sm font-bold text-forest';
---

<BaseLayout
  title="Contact | Book a Session in New Haven CT | Elm City Photography"
  description="Get in touch with Elm City Photography about engagement, proposal, or graduation sessions in New Haven, CT. We reply within 48 hours."
>
  <section class="px-5 pb-8 pt-12 md:px-10 md:pt-16">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <aside class="relative self-start rounded-[2rem] bg-forest p-8 text-cream md:p-12">
        <p class="eyebrow text-gold">Get in touch</p>
        <h1 class="mt-4 text-[clamp(2.8rem,6vw,4.75rem)] leading-[0.98]">let's talk.</h1>
        <p class="mt-6 text-lg leading-relaxed text-cream/80">
          Planning an engagement session, a proposal, or a graduation portrait? We'd love to hear about it. Fill out the form, or reach us directly.
        </p>
        <ul class="mt-8 space-y-4">
          <li>
            <a href="mailto:hello@elmcityphotography.com" class="inline-flex items-center gap-3 font-bold transition-colors hover:text-gold">
              <Mail class="h-5 w-5 text-gold" aria-hidden="true" />
              hello@elmcityphotography.com
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/elm.city.photography/" class="inline-flex items-center gap-3 font-bold transition-colors hover:text-gold" rel="noopener" target="_blank">
              <Instagram class="h-5 w-5 text-gold" aria-hidden="true" />
              @elm.city.photography
            </a>
          </li>
        </ul>
        <p class="mt-10 inline-block rounded-full bg-gold px-5 py-2 text-sm font-bold text-forest">We reply within 48 hours</p>
      </aside>

      <form action="https://formspree.io/f/xlgkvkez" method="post" class="space-y-6 lg:pt-4">
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class={label}>Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required class={field} placeholder="Jane & John" />
          </div>
          <div>
            <label for="email" class={label}>Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required class={field} placeholder="you@example.com" />
          </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="event-type" class={label}>Type of session</label>
            <select id="event-type" name="event-type" class={field}>
              <option value="">Select one…</option>
              <option>Engagement</option>
              <option>Proposal</option>
              <option>Graduation</option>
              <option>Portrait</option>
              <option>Something else</option>
            </select>
          </div>
          <div>
            <label for="event-date" class={label}>Date (if you have one)</label>
            <input id="event-date" name="event-date" type="text" class={field} placeholder="Month DD, YYYY" />
          </div>
        </div>
        <div>
          <label for="message" class={label}>Tell us about your plans</label>
          <textarea
            id="message"
            name="message"
            rows="7"
            class:list={[field, 'resize-none']}
            placeholder="The location, the vibe, what matters most to you. Whatever feels relevant."
          ></textarea>
        </div>
        <button type="submit" class="btn-pill btn-dark">Send message</button>
      </form>
    </div>
  </section>
</BaseLayout>
