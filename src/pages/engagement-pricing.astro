---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCards from '../components/PackageCards.astro';
import GoodToKnow from '../components/GoodToKnow.astro';
import CtaBand from '../components/CtaBand.astro';
import { engagement } from '../data/pricing';
---

<BaseLayout
  title="Engagement Pricing | New Haven CT | Elm City Photography"
  description="Engagement session pricing from Elm City Photography in New Haven, CT. Sessions from $375. Travel anywhere in Connecticut included."
>
  <section class="px-5 pt-20 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <h1 class="sr-only">Engagement sessions</h1>
      <PackageCards packages={engagement} />
    </div>
  </section>

  <GoodToKnow />

  <CtaBand title="Let's plan your session." secondary={{ href: '/engagements/', label: 'See the portfolio' }} />
</BaseLayout>
