---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCards from '../components/PackageCards.astro';
import GoodToKnow from '../components/GoodToKnow.astro';
import PricingHeader from '../components/PricingHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import PricingFaq from '../components/PricingFaq.astro';
import { engagementFaq } from '../data/faq';
import { engagement } from '../data/pricing';
---

<BaseLayout
  title="Engagement Pricing | New Haven CT | Elm City Photography"
  description="Engagement session pricing from Elm City Photography in New Haven, CT. Sessions from $375. Travel anywhere in Connecticut included."
>
  <section class="px-5 pt-20 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <PricingHeader current="engagement" title="Engagement sessions" intro="Sessions from one relaxed hour to a full golden-hour evening. Travel anywhere in Connecticut is included." />
      <PackageCards packages={engagement} />
    </div>
  </section>

  <GoodToKnow />

  <PricingFaq items={engagementFaq} />

  <CtaBand title="Let's plan your session." secondary={{ href: '/', label: 'See the portfolio' }} />
</BaseLayout>
