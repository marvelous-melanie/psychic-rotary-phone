---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SkipLink from '../components/SkipLink.astro';
import Seo from '../components/Seo.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import '../styles/global.css';
import { engagement, graduation, type Pkg } from '../data/pricing';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  heroPreload?: string;
}

const { title, description, image, canonicalUrl, heroPreload } = Astro.props;
if (!Astro.site) throw new Error('Astro.site is not set — check astro.config.mjs');
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();

const SITE = 'https://elmcityphotography.com';
const offer = (category: string, pkgs: Pkg[], path: string) => ({
  '@type': 'OfferCatalog',
  name: category,
  url: `${SITE}${path}`,
  itemListElement: pkgs.map((p) => ({
    '@type': 'Offer',
    name: `${p.name} (${category})`,
    description: p.items.join(', '),
    price: p.price.replace(/[^0-9.]/g, ''),
    priceCurrency: 'USD',
    url: `${SITE}${path}`,
  })),
});
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'ProfessionalService'],
      '@id': `${SITE}/#business`,
      name: 'Elm City Photography',
      url: SITE,
      logo: `${SITE}/og-default.jpg`,
      image: `${SITE}/og-default.jpg`,
      description: 'Engagement, proposal, and graduation portrait photography based in New Haven, CT. Travel anywhere in Connecticut is included.',
      email: 'hello@elmcityphotography.com',
      address: { '@type': 'PostalAddress', addressLocality: 'New Haven', addressRegion: 'CT', addressCountry: 'US' },
      areaServed: [
        { '@type': 'City', name: 'New Haven, CT' },
        { '@type': 'City', name: 'Hamden, CT' },
        { '@type': 'City', name: 'West Haven, CT' },
        { '@type': 'AdministrativeArea', name: 'New Haven County, CT' },
        { '@type': 'State', name: 'Connecticut' },
      ],
      knowsAbout: ['Engagement photography', 'Proposal photography', 'Graduation photography', 'Portrait photography'],
      priceRange: '$175–$995',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Photography sessions',
        itemListElement: [
          offer('Engagement session', engagement, '/engagement-pricing/'),
          offer('Graduation session', graduation, '/graduation-pricing/'),
        ],
      },
      sameAs: ['https://www.instagram.com/elm.city.photography'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'Elm City Photography',
      url: SITE,
      publisher: { '@id': `${SITE}/#business` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} image={image} canonicalUrl={canonical} />
    <slot name="head" />
    {heroPreload && <link rel="preload" as="image" href={heroPreload} fetchpriority="high" />}
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var add = function () { document.documentElement.classList.add('reveal-js'); };
        add();
        document.addEventListener('astro:after-swap', add);
        // Safety net: never leave content hidden if the reveal script fails to load.
        setTimeout(function () { if (!window.__revealReady) document.documentElement.classList.remove('reveal-js'); }, 3000);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..900,0..100;1,9..144,400..900,0..100&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"
      rel="stylesheet"
    />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen overflow-x-clip bg-cream text-ink">
    <ClientRouter />
    <SkipLink />
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <ScrollReveal />
  </body>
</html>
