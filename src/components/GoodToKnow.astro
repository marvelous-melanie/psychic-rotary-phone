---
type Item = { title: string; body: string };
interface Props { items?: Item[] }

const travel: Item = {
  title: 'Travel',
  body: 'Anywhere in Connecticut is always included. Rhode Island, Massachusetts, and greater New York are available for a small flat travel fee. Just ask.',
};

const { items = [
  {
    title: 'Where',
    body: "East Rock, Lighthouse Point, campus, the harbor, Wooster Square. If you have a place in mind, we'll make it work. If not, we'll suggest one that suits the season.",
  },
  travel,
  {
    title: 'When',
    body: "The best light is the last 60–90 minutes before sunset, so that's when we usually shoot. We'll plan your session around it.",
  },
] } = Astro.props;
---

<section class="px-5 pt-24 md:px-10">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-center text-[clamp(2.2rem,4.5vw,3.4rem)] leading-none text-forest">Good to know</h2>
    <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0">
      {items.map((item, i) => (
        <div class:list={['leading-relaxed text-ink/85', i === 0 ? 'md:pr-10' : i === items.length - 1 ? 'border-gold md:border-l-2 md:pl-10' : 'border-gold md:border-l-2 md:px-10']}>
          <p class="font-display text-2xl text-forest">{item.title}</p>
          <p class="mt-3">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
