---
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  body?: string;
  label?: string;
  secondary?: { href: string; label: string };
}

const {
  title = 'Ready when you are.',
  body = "Tell us what you're planning and we'll get back to you within 48 hours.",
  label = 'Book with us',
  secondary,
} = Astro.props;
---

<section class="relative mt-24 bg-forest px-5 pb-20 pt-20 text-center text-cream">
  <h2 class="mx-auto max-w-6xl text-[clamp(2.2rem,5vw,4rem)] leading-none [text-wrap:balance] sm:whitespace-nowrap">{title}</h2>
  <p class="mx-auto mt-5 max-w-md text-lg leading-relaxed text-cream/80">{body}</p>
  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
    <a href={withBase('/contact/')} class="btn-pill btn-gold">{label}</a>
    {secondary && (
      <a href={withBase(secondary.href)} class="btn-pill border-2 border-cream/40 text-cream hover:border-cream">
        {secondary.label}
      </a>
    )}
  </div>
</section>
