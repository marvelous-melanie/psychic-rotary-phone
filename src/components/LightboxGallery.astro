---
import { Picture, getImage } from 'astro:assets';
import type { GalleryImage } from '../lib/galleries';

interface Props {
  images: GalleryImage[];
  galleryId: string;
  /** Curated layout: rows of filenames. Images not listed are appended in rows of three. */
  rows?: string[][];
}

const { images, galleryId, rows = [] } = Astro.props;

const prepared = await Promise.all(
  images.map(async (item) => {
    const lightbox = await getImage({
      src: item.image,
      width: Math.min(item.image.width, 2400),
      format: 'webp',
      quality: 85,
    });

    return { ...item, lightbox, ratio: item.image.width / item.image.height };
  }),
);

type Prepared = (typeof prepared)[number];
const byName = new Map(prepared.map((p) => [p.filename, p]));
const used = new Set<string>();
const layout: Prepared[][] = rows
  .map((row) => row.map((name) => byName.get(name)).filter((p): p is Prepared => !!p && !used.has(p.filename) && !!used.add(p.filename)))
  .filter((row) => row.length > 0);
const rest = prepared.filter((p) => !used.has(p.filename));
for (let i = 0; i < rest.length; i += 3) layout.push(rest.slice(i, i + 3));
let index = 0;
---

<div id={`gallery-${galleryId}`} data-reveal-intro class="mx-auto max-w-7xl space-y-3 px-4 pb-20 md:space-y-4">
  {layout.map((row) => (
    <div class="space-y-3 sm:flex sm:gap-3 sm:space-y-0 md:gap-4">
      {row.map((item) => {
        const i = index++;
        return (
          <a
            href={item.lightbox.src}
            data-pswp-width={item.lightbox.attributes.width}
            data-pswp-height={item.lightbox.attributes.height}
            class="block overflow-hidden rounded-xl bg-paper sm:[flex:var(--ar)_1_0%]"
            style={`--ar: ${item.ratio.toFixed(4)}; aspect-ratio: ${item.ratio.toFixed(4)};`}
            aria-label={`Open image: ${item.alt}`}
          >
            <Picture
              src={item.image}
              formats={['avif', 'webp']}
              widths={[480, 768, 1024, 1440]}
              sizes={`(min-width: 640px) ${Math.round(Math.min(100, (item.ratio / row.reduce((a, r) => a + r.ratio, 0)) * 100 + 5))}vw, 100vw`}
              alt={item.alt}
              loading={i < 6 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover transition duration-500 hover:scale-[1.02]"
            />
          </a>
        );
      })}
    </div>
  ))}
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipe from 'photoswipe';
  import 'photoswipe/style.css';

  function initLightboxes() {
    document.querySelectorAll('[id^="gallery-"]').forEach((gallery) => {
      if (gallery instanceof HTMLElement && gallery.dataset.pswpInitialized !== 'true') {
        const lightbox = new PhotoSwipeLightbox({
          gallery,
          children: 'a',
          pswpModule: PhotoSwipe,
          preload: [1, 2],
          bgOpacity: 0.94,
          showHideAnimationType: 'zoom',
          wheelToZoom: false,
        });

        lightbox.init();
        gallery.dataset.pswpInitialized = 'true';
      }
    });
  }

  initLightboxes();
  document.addEventListener('astro:page-load', initLightboxes);
</script>
