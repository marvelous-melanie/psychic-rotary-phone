---
import { withBase } from '../lib/paths';
import Wordmark from './Wordmark.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (path: string) => (withBase(path).replace(/\/$/, '') || '/') === currentPath;

type NavLink = { href: string; label: string; children?: { href: string; label: string }[] };
const isLinkActive = (link: NavLink) => (link.children ? link.children.some((c) => isActive(c.href)) : isActive(link.href));

const links: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/engagements/', label: 'Engagements' },
  { href: '/graduations/', label: 'Graduations' },
  {
    href: '/engagement-pricing/',
    label: 'Pricing',
    children: [
      { href: '/engagement-pricing/', label: 'Engagement pricing' },
      { href: '/graduation-pricing/', label: 'Graduation pricing' },
    ],
  },
  { href: '/about/', label: 'About' },
];
---

<header class="relative z-50 bg-forest text-cream" id="site-header">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-5 py-4 md:px-10 md:py-5">
    <!-- Left: primary nav (desktop) -->
    <nav aria-label="Primary" class="hidden flex-1 lg:block">
      <ul class="flex items-center gap-6 text-[0.8rem] font-bold uppercase tracking-[0.14em]">
        {links.map((link) =>
          link.children ? (
            <li class="group relative">
              <a
                href={withBase(link.href)}
                aria-haspopup="true"
                class:list={[
                  'inline-flex items-center gap-1.5 border-b-2 pb-1 transition-colors',
                  isLinkActive(link) ? 'border-gold text-cream' : 'border-transparent text-cream/80 hover:text-gold',
                ]}
              >
                {link.label}
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="transition-transform group-hover:rotate-180 group-focus-within:rotate-180"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <div class="invisible absolute left-1/2 top-full z-50 w-60 -translate-x-1/2 pt-3 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="overflow-hidden rounded-2xl bg-cream p-2 text-forest shadow-xl">
                  {link.children.map((c) => (
                    <li>
                      <a
                        href={withBase(c.href)}
                        aria-current={isActive(c.href) ? 'page' : undefined}
                        class:list={['block rounded-xl px-4 py-3 transition-colors hover:bg-mint', isActive(c.href) && 'bg-mint']}
                      >
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={withBase(link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center border-b-2 pb-1 transition-colors',
                  isActive(link.href) ? 'border-gold text-cream' : 'border-transparent text-cream/80 hover:text-gold',
                ]}
              >
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <!-- Center: wordmark -->
    <a href={withBase('/')} class="shrink-0 transition-opacity hover:opacity-90" aria-label="Elm City Photography home">
      <Wordmark class="h-14 w-auto md:h-[4.5rem]" />
    </a>

    <!-- Right: CTA (desktop) + menu toggle (mobile) -->
    <div class="flex flex-1 items-center justify-end gap-4">
      <a href={withBase('/contact/')} class="btn-pill hidden bg-cream !px-7 !py-3 text-forest hover:bg-gold sm:inline-flex">
        Book with us
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-cream/10 text-cream transition-colors hover:bg-cream/20 lg:hidden"
      >
        <svg id="icon-hamburger" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="7" x2="19" y2="7" /><line x1="3" y1="15" x2="19" y2="15" />
        </svg>
        <svg id="icon-close" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden">
          <line x1="5" y1="5" x2="17" y2="17" /><line x1="17" y1="5" x2="5" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <nav id="mobile-nav" aria-label="Mobile navigation" class="hidden border-t border-cream/10 lg:hidden">
    <ul class="space-y-1 px-5 py-6">
      {links.flatMap((link) => link.children ?? [link]).map((link) => (
        <li>
          <a
            href={withBase(link.href)}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={['font-display block py-2 text-3xl', isActive(link.href) ? 'text-gold' : 'text-cream hover:text-gold']}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-4">
        <a href={withBase('/contact/')} class="btn-pill btn-gold w-full">Book with us</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  function initMenu() {
    (document as any)._menuAC?.abort();
    const ac = new AbortController();
    (document as any)._menuAC = ac;
    const { signal } = ac;

    const toggle = document.getElementById('mobile-menu-toggle');
    const nav = document.getElementById('mobile-nav');
    const iconHamburger = document.getElementById('icon-hamburger');
    const iconClose = document.getElementById('icon-close');
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      nav.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      iconHamburger?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(nav.classList.contains('hidden')), { signal });
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false), { signal }));
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
