---
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
  title?: string;
}

const { items, title = 'Questions, answered' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<section class="px-5 pt-24 md:px-10">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-center text-[clamp(2.2rem,4.5vw,3.4rem)] leading-none text-forest">{title}</h2>
    <div class="mt-12 divide-y-2 divide-gold/40 rounded-3xl bg-mint px-6 md:px-10">
      {items.map(({ q, a }) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl text-forest [&::-webkit-details-marker]:hidden md:text-2xl">
            <span>{q}</span>
            <span aria-hidden="true" class="shrink-0 text-2xl leading-none text-forest transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-ink/85">{a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</section>
